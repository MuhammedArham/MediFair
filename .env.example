# Synthetic demo only. Set to false only after production safety gates are built.
DEMO_MODE=true
EMAIL_TRANSPORT=mock
AI_PROVIDER=mock
# A PostgreSQL URL from a database you control. Use a separate database for local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medifair?sslmode=require"
# Optional direct URL for Prisma migrations when DATABASE_URL points to a pooler.
DIRECT_URL=
# Production requires a private Vercel Blob store and its server-side token.
DOCUMENT_STORAGE=
BLOB_READ_WRITE_TOKEN=
# Optional absolute path for private local PDF storage. Defaults to .private-documents/.
DOCUMENT_STORAGE_DIR=

# Required on a public production deployment. This protects the synthetic single-operator workspace.
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Development simulator is only available from a loopback host in NODE_ENV=development.
ENABLE_EMAIL_SIMULATOR=true

# Server-side integrations only. Never commit populated .env files.
OPENAI_API_KEY=
# Set AI_PROVIDER=openai with both values to run structured quote extraction on fictional demo email only.
OPENAI_MODEL=
RESEND_API_KEY=
# Bare address on a domain verified and enabled for sending in Resend.
RESEND_FROM_EMAIL=
# Base address on a receiving-enabled Resend domain. Replies use unique +mf aliases.
RESEND_INBOUND_ADDRESS=
# Signing secret for the delivery-event webhook, not the API key.
RESEND_WEBHOOK_SECRET=
# Public base URL used when registering the webhook in Resend, e.g. https://your-app.example.
APP_BASE_URL=

# Comma-separated exact test addresses. Required for real Resend sends in demo mode; unused by mock transport.
DEMO_ALLOWED_RECIPIENTS=

# Optional restricted own-account Resend test sender; must match the sole demo recipient.
RESEND_TEST_RECIPIENT=
